<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#006E80"/><corners android:radius="4dp"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#007F95"/><corners android:radius="4dp"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="#007F95"/><corners android:radius="4dp"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
    <item><shape><solid android:color="#344552"/><corners android:radius="4dp"/><stroke android:width="1dp" android:color="#70818C"/></shape></item>
</selector>
