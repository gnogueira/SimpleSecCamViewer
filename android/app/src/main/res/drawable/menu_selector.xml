<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#006E80"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#007F95"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="#007F95"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
    <item><color android:color="@android:color/transparent"/></item>
</selector>
